aws_region          = "eu-central-1"
account_id          = "REPLACE_WITH_ACCOUNT_01_ACCOUNT_ID"
terraform_role_arn  = "arn:aws:iam::REPLACE_ACCOUNT_ID:role/TerraformExecutionRole"
common_tags = {
  ManagedBy = "Terraform"
  Account   = "account-01"
  Service   = "s3"
}
buckets = {
  "primary" = {
    bucket_name        = "REPLACE-UNIQUE-BUCKET-NAME"
    versioning_enabled = true
    block_public_access = true
    object_ownership   = "BucketOwnerEnforced"
  }
}
