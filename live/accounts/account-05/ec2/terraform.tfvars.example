aws_region          = "eu-central-1"
account_id          = "REPLACE_WITH_ACCOUNT_05_ACCOUNT_ID"
terraform_role_arn  = "arn:aws:iam::REPLACE_ACCOUNT_ID:role/TerraformExecutionRole"
common_tags = {
  ManagedBy = "Terraform"
  Account   = "account-05"
  Service   = "ec2"
}
instances = {
  "app-01" = {
    ami_id             = "ami-REPLACE"
    instance_type      = "t3.xlarge"
    subnet_id          = "subnet-REPLACE"
    security_group_ids = ["sg-REPLACE"]
    key_name           = "REPLACE_KEY_PAIR"
    root_volume_size   = 70
    root_volume_type   = "gp3"
    root_volume_iops   = 3000
    root_volume_throughput = 125
    tags = {
      Name = "REPLACE_INSTANCE_NAME"
    }
  }
}
